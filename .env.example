# PostgreSQL. Set POSTGRES_ENABLED=false to run without a database (admin area is then disabled).
POSTGRES_ENABLED=true
DATABASE_URL="postgresql://ovcc:ovcc_local@localhost:5432/ovcc"

# Admin area (/admin). Discord OAuth2 app: add <SITE_URL>/admin/auth/callback as a redirect URI.
SITE_URL=https://www.orvioncc.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs allowed into /admin.
ADMIN_DISCORD_IDS=
